# ==============================================================================
# Polymuh: Drosophila Vision-Motor Configuration (.env)
# ==============================================================================

# Аппаратное устройство для инференса SNN: 'cpu' или 'cuda' (при наличии GPU)
DEVICE= #cpu

# Ключевое слово для автопоиска окна игры Polytrack (Desktop-приложение)
WINDOW_KEYWORD=PolyTrack

# Целевая частота кадров и жесткий бюджет задержки (мс)
TARGET_FPS= #60
MAX_ALLOWED_LATENCY_MS= #40.0

# Параметры симуляции LIF спайковой нейросети мозга дрозофилы
SNN_SUBSTEPS= #8
SNN_ALPHA_DECAY= #0.85
SNN_SYNAPTIC_GAIN= #0.04

# Пороги чувствительности моторного декодера (Нисходящие нейроны DN -> WASD)
MOTOR_STEER_THRESHOLD= #0.12
MOTOR_THROTTLE_THRESHOLD= #0.15
MOTOR_BRAKE_THRESHOLD= #0.22

# Порог детекции падения с трассы (дисперсия лапласиана текстуры)
FALL_CONTRAST_THRESHOLD= #80.0

# Порог распознавания плашки сброса / респауна Polytrack ("Нажмите R / Enter...")
RESPAWN_DETECTION_THRESHOLD= #0.68


# FlyWire Codex / CAVE API Credentials
# Примечание: для автономной работы токен не требуется, так как система
# автоматически использует эталонный подграф коннектома FlyWire v783 (102 нейрона,
# 376 синапсов), уже собранный и закэшированный в data/connectome/flywire_subgraph.npz.
# Если вы захотите подключиться напрямую к серверу FlyWire CAVE, токен из
# https://global.daf-apis.com/auth/api/v1/user/token можно вставить сюда:
FLYWIRE_API_TOKEN=
CAVE_TOKEN=