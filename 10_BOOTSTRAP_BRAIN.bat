@echo off
chcp 65001 > nul
cd /d "%~dp0"
title Polytrack Drosophila - Bootstrap Brain (Fast Synthetic Pre-Training)

echo ===================================================================
echo     СИНТЕТИЧЕСКИЙ БУТСТРАП МОЗГА МУХИ (100 Поколений)
echo ===================================================================
echo.
echo Данный скрипт проводит предварительную эволюцию нейронов (166 параметров)
echo на 3 поведенческих нишах (скорость, центр трассы, дрифт) в быстром
echo синтетическом окружении без необходимости открывать игру PolyTrack.
echo.
echo Это дает сильный базовый интеллект перед выходом на реальную трассу.
echo.

set /p gens="Количество поколений [по умолчанию 100]: "
if "%gens%"=="" set gens=100

set /p pop="Размер популяции на поколение [по умолчанию 12]: "
if "%pop%"=="" set pop=12

set /p frames="Кадров на заезд [по умолчанию 600]: "
if "%frames%"=="" set frames=600

echo.
echo Запуск бутстрапа: %gens% поколений, %pop% кандидатов...
echo Пожалуйста, подождите (обычно занимает около 1-2 минут)...
echo.

python trainer.py --generations %gens% --population %pop% --max-frames %frames%

echo.
echo ===================================================================
echo Бутстрап завершен! Веса сохранены в data/brain_weights_best.pt
echo Теперь муха готова к боевому обучению в PolyTrack (4_TRAIN_AGENT.bat)
echo или тестовому заезду в игре (2_RUN_AUTOPILOT.bat).
echo ===================================================================
pause
